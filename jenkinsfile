pipeline {
    agent any

    environment {
        S3_BUCKET = 's3://technova-jenkins-backup-aritra'
    }

    stages {
        stage('Archive & Compress') {
            steps {
                echo "Packaging files from workspace..."
                sh 'tar -czf jenkins-project.tar.gz .'
            }
        }

        stage('Upload to AWS S3') {
            steps {
                echo "Pushing artifact to AWS..."
                withCredentials([usernamePassword(
                    credentialsId: 'aws-s3-backup-creds',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                        aws s3 cp jenkins-project.tar.gz ${S3_BUCKET}/backups/
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning up workspace..."
            sh 'rm -f *.tar.gz'
        }
        success {
            echo "Deployment to S3 successful!"
        }
        failure {
            echo "Build failed. Check SCM URL or credentials."
        }
    }
}
